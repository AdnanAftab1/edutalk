generator client {
  provider = "prisma-client-js"
  output   = "../appi/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String   @unique
  password    String
  email       String   @default("")
  phoneNumber String   @default("")
  AuthFile    String   @default("")
  role        Role     @default(Parent)
  status      Status   @default(Unverified)
  Parent      Parent?
  Teacher     Teacher?
  Admin       Admin?
}

model Admin {
  id     String @id @default(uuid())
  UserId String @unique
  User   User   @relation(references: [id], fields: [UserId])
}

model Parent {
  Pid          String            @id @unique
  User         User              @relation(references: [id], fields: [Pid])
  StudentName  String
  ClassId      String
  Class        Class             @relation(fields: [ClassId], references: [id])
  ParentName   String            @default("Adnan")
  MeetReqSend  Meeting_Request[] @relation(name: "attends")
  Attendance   Attendance[]
  Academics    Academics[]
  ChatMessages ChatMessages[]
}

model Teacher {
  Tid            String            @id @unique
  TeacherName    String            @unique
  User           User              @relation(references: [id], fields: [Tid])
  MeetReqRecieve Meeting_Request[] @relation(name: "recTeach")
  Subjects       Subject[]
  ChatMessages   ChatMessages[]
  Announcements  Annoucements[]
  Academics      Academics[]
  Class          Class?
}

model Subject {
  Sid       String      @id @default(uuid())
  Name      String
  ClassId   String
  Class     Class       @relation(references: [id], fields: [ClassId])
  TeacherId String
  Teacher   Teacher     @relation(references: [Tid], fields: [TeacherId])
  Academics Academics[]
}

model Class {
  id             String         @id @default(uuid())
  Name           String         @unique
  Parent         Parent[]
  Subjects       Subject[]
  Attendance     Attendance[]
  ClassTeacherId String         @unique
  Teacher        Teacher        @relation(references: [Tid], fields: [ClassTeacherId])
  Annoucements   Annoucements[]
}

model Annoucements {
  id       String   @id @default(uuid())
  Text     String
  SenderId String?
  Teacher  Teacher? @relation(fields: [SenderId], references: [Tid])
  Title    String
  Date     DateTime
  ClassID  String?
  Class    Class?   @relation(fields: [ClassID], references: [id])
}

model Meeting_Request {
  id               String     @id @default(uuid())
  ParentId         String
  Sender           Parent     @relation(name: "attends", fields: [ParentId], references: [Pid])
  date             DateTime
  content          String
  TeacherId        String
  MeetStatus       StatusMeet @default(Pending)
  Rejection_Reason String?
  Teacher          Teacher    @relation(name: "recTeach", fields: [TeacherId], references: [Tid])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  isPresent Boolean
  Issue_For String
  Class     Class    @relation(fields: [Issue_For], references: [id])
  ParentId  String
  Parent    Parent   @relation(fields: [ParentId], references: [Pid])
}

model Academics {
  ExamName   String
  id         String   @id @default(uuid())
  Pid        String
  SubjectID  String
  Grade      String
  ReportLink String?
  Date       DateTime
  TeacherID  String
  Teacher    Teacher  @relation(fields: [TeacherID], references: [Tid])
  Parent     Parent   @relation(references: [Pid], fields: [Pid])
  Subject    Subject  @relation(references: [Sid], fields: [SubjectID])
}

model ChatMessages {
  MessageId String   @id @default(uuid())
  Pid       String
  Tid       String
  Parent    Parent   @relation(references: [Pid], fields: [Pid])
  Teacher   Teacher  @relation(references: [Tid], fields: [Tid])
  Sender    Role @default(Parent)
  Content   String
  Date      DateTime
}

enum Role {
  Parent
  Teacher
  Admin
}

enum Status {
  Unverified
  Rejected
  Successfull
}

enum StatusMeet {
  Pending
  Rejected
  Approved
}
